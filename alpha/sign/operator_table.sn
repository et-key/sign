	`*` : `mul`
	`/` : `div`
	`%` : `mod`
	`^` : `pow`
	`'` : `get_prop`
	`@` : `get_at`
	`<<` : `bit_shift_left`
	`>>` : `bit_shift_right`
	`||` : `bit_or`
	`;;` : `bit_xor`
	`&&` : `bit_and`

